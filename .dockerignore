vendor
node_modules

# Secrets and runtime config (mounted at runtime)
.env
.env.*
!.env.example

# Runtime data (uploads and logs are mounted as volumes)
storage/app/public/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
public/storage

